# Copy to .env.local for local dev, and set the same keys in Vercel → Settings → Environment Variables.

# Claude (writes the leaks in French). Without it, the audit uses built-in templates.
ANTHROPIC_API_KEY=

# Supabase (audit storage). Service-role key: server only, never in the browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Secrets: generate each with  openssl rand -base64 32
AUDIT_TOKEN_SECRET=
AUDIT_IP_SALT=

# Public address of this backend, used for share links and the share image.
PUBLIC_BASE_URL=https://api.solen.fr

# Front end on your own domain (see docs/AUDIT_API.md). Leave empty to use the built-in pages.
ALLOWED_ORIGINS=https://solen.fr,https://www.solen.fr
REPORT_URL_TEMPLATE=https://solen.fr/audit/rapport/{id}

# Legacy tracking endpoints (/events, /heatmap, /analyze)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
